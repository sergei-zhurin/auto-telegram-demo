# Copy this file to .env and fill in credentials for accounts and chats you control.
# Never commit .env or paste live credentials into source code.

# OpenAI API
OPENAI_API_KEY=""

# Telegram bot tokens (create bots with @BotFather)
BOT_TEST_TOKEN=""
BOT_CTM_TOKEN=""
BOT_CTM_MAIN_TOKEN=""

# Telegram chat IDs (the bots must have permission to post in these chats)
CHAT_CTM_BS_ID=""
CHAT_CTM_MAIN_ID=""
CHAT_PM_ID=""
CHAT_CTM_ALERTING_ID=""

# Public channel link used in post footers; use a placeholder for local testing.
TELEGRAM_CHANNEL_LINK="https://t.me/your_channel"

# X API credentials (needed because main.py always attempts X publication)
BEARER_TOKEN=""
CONSUMER_KEY=""
CONSUMER_SECRET=""
ACCESS_TOKEN=""
ACCESS_TOKEN_SECRET=""
